# Faust: in the receivers/faust folder keep only the .dsp sources and
# the README -- ignore everything else (compiled executables with no
# extension, intermediate .cpp, .o, .app/.dSYM bundles, whatever name
# they take)
mapping_layer/receivers/faust/*
!mapping_layer/receivers/faust/*.dsp
!mapping_layer/receivers/faust/*.md